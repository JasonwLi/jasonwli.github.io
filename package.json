{
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "verify:basis": "node scripts/verify-basis.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:cube": "node --experimental-strip-types scripts/terrain/check_cube_parity.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:landmarks": "node --experimental-strip-types src/three/monuments/dev/check-landmarks.ts"
  },
  "dependencies": {
    "@fontsource/castoro": "^5.3.0",
    "@fontsource/castoro-titling": "^5.3.0",
    "@react-three/fiber": "^9.6.1",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "troika-three-text": "0.52.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "world-atlas": "^2.0.2"
  }
}
